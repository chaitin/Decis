# Decis configuration.
#
# Copy to `.env` and edit. Everything here is optional except DECIS_API_KEY when
# you are listening on a non-loopback address -- Decis refuses to start in that
# combination rather than exposing an unauthenticated inference server.
#
#   cp .env.example .env
#
# Any environment variable already set in the shell wins over `.env`.

# --- authentication ---------------------------------------------------------
# The bearer token clients must send as `Authorization: Bearer <token>`.
# Comma-separate several to rotate keys without downtime.
DECIS_API_KEY=change-me

# Allow running with no token configured. Only permitted on a loopback address
# unless DECIS_ALLOW_NO_AUTH=1 is set explicitly.
# DECIS_ALLOW_NO_AUTH=0

# --- network ----------------------------------------------------------------
DECIS_HOST=0.0.0.0
DECIS_PORT=8000

# --- engine -----------------------------------------------------------------
# Which engine answers requests when the client omits `model`, and which one
# `decis serve` loads at startup.
DECIS_DEFAULT_ENGINE=mock

# Accept "jev-latest" (the official SDK's default model name) and similar
# "whatever default you run" names, answering with the loaded engine instead of
# returning 422. This is what makes swapping TYPESAFE_BASE_URL alone sufficient.
# The substitution is reported in the response under decis.requested_model.
# DECIS_ACCEPT_FOREIGN_DEFAULTS=1

# Where model weights live. A directory found here wins over the network, so an
# image with weights baked in never reaches out. Expected layout is
# <DECIS_MODEL_DIR>/<engine-id>/, and a raw snapshot_download (which nests a
# subfolder inside) is recognised too.
# DECIS_MODEL_DIR=/app/models

# Point ONE engine at a directory of your own -- a fine-tune, or weights on a
# different volume. The suffix is the engine id uppercased with non-alphanumeric
# characters replaced by "_", so "laya-multilingual" becomes
# DECIS_MODEL_PATH_LAYA_MULTILINGUAL. This beats DECIS_MODEL_DIR.
# DECIS_MODEL_PATH_LAYA_MULTILINGUAL=/srv/finetunes/acme-triage

# --- limits -----------------------------------------------------------------
# Rejected before the body is read, so a huge `state` cannot exhaust memory.
DECIS_MAX_REQUEST_BYTES=2097152
# Must stay under the official SDK's 10 s per-request timeout: past that the SDK
# gives up and RE-SENDS, which multiplies load on a server that is already busy.
DECIS_REQUEST_TIMEOUT_MS=8000

# --- runtime ----------------------------------------------------------------
# Leave unset to let torch choose. Measured default recommendation is 8-16;
# using every core is often slower. See docs/feasibility.md §4.4.
# DECIS_TORCH_THREADS=8
DECIS_LOG_LEVEL=info
# Request bodies can contain user data, so payloads are not logged by default.
# DECIS_LOG_PAYLOADS=0

# How long shutdown waits for an in-flight engine load before exiting without
# closing it. Must be below your orchestrator's terminationGracePeriodSeconds, or
# SIGKILL arrives while we are still waiting.
#DECIS_SHUTDOWN_GRACE_MS=20000

# Force a device: cuda, mps or cpu. Unset picks the best available. Useful for running
# a CPU-only comparison on a GPU host, and for pinning dtype selection -- kev's dtype
# default depends on the device (fp32 on cpu, bf16 on cuda; see docs/feasibility.md §4).
#DECIS_DEVICE=cpu

# Force fp32 / fp16 / bf16 for the served engine. Unset picks per (engine, device) from
# DTYPE_DEFAULTS in src/decis/engines/registry.py. Mainly for re-measuring a dtype on
# your own hardware; a combination Decis knows to be bad logs a warning rather than
# being refused. Engines that decide dtype themselves (Laya) ignore this.
#DECIS_DTYPE=bf16
