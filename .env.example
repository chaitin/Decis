# Decis configuration.
#
# Copy to `.env` and edit. Everything here is optional except DECIS_API_KEY when
# you are listening on a non-loopback address -- Decis refuses to start in that
# combination rather than exposing an unauthenticated inference server.
#
#   cp .env.example .env
#
# Any environment variable already set in the shell wins over `.env`.

# --- authentication ---------------------------------------------------------
# The bearer token clients must send as `Authorization: Bearer <token>`.
# Comma-separate several to rotate keys without downtime.
DECIS_API_KEY=change-me

# Allow running with no token configured. Only permitted on a loopback address
# unless DECIS_ALLOW_NO_AUTH=1 is set explicitly.
# DECIS_ALLOW_NO_AUTH=0

# --- network ----------------------------------------------------------------
DECIS_HOST=0.0.0.0
DECIS_PORT=8000

# --- docker compose ---------------------------------------------------------
# Which engines `docker compose up` starts. The default is one engine on purpose:
# both together hold several GB of weights in memory. Add more, comma-separated,
# or name one for a single command. (Compose reads this from `.env`, and a value
# exported in the shell wins over this file.)
COMPOSE_PROFILES=laya-multilingual

# The published images carry the engine's weights, so `docker compose up` downloads
# nothing. Inside the Decis checkout a bare `docker compose up` also loads
# docker-compose.override.yml, which builds the same services from source into
# `decis-local:*` instead; pass `-f docker-compose.yml` to run the published images.

# Host ports for the published services. The engine container always listens on 8000 --
# DECIS_PORT is pinned per service -- so only that one changes, and the two engine ports
# must differ: two engines on one host port would collide. The playground listens on 8080
# inside its own container.
DECIS_HOST_PORT=8000
DECIS_KEV_HOST_PORT=8001

# --- playground --------------------------------------------------------------
# The games at http://localhost:8080 (snake, dino, tetris), started by the same
# `docker compose up` as the engine. It needs no other setting: it finds the engine by
# asking /readyz, so the same service works under either profile and no engine id has to
# be kept in sync here.
DECIS_PLAYGROUND_HOST_PORT=8080

# Anyone who can reach this port can use the model. The playground attaches DECIS_API_KEY
# itself and proxies /v1/systemone, so publishing it on every interface is the same
# decision as publishing the engine's port -- without even the token prompt. The default
# matches the engine services because a deployment on a remote host expects to reach it;
# bind it to loopback on a host you do not trust, by putting the address in this variable
# (Compose reads `IP:hostPort` here).
# DECIS_PLAYGROUND_HOST_PORT=127.0.0.1:8080

# Skip the search and name the engine. When set it is tried first, and the built-in
# candidate list (`http://laya-multilingual:8000`, `http://kev-0.8b:8000`,
# `http://host.docker.internal:8000`) is the fallback. Set it when the engine is
# somewhere this container cannot guess:
# DECIS_PLAYGROUND_UPSTREAM=http://laya-multilingual:8000
# DECIS_PLAYGROUND_CANDIDATES=http://my-engine:8000,http://host.docker.internal:8000

# --- outbound network (only for a restricted network) ------------------------
# Not needed for the published engine images: they already contain their weights. Set
# these when the *container* itself has to reach the Hub -- running the weightless
# `-runtime` image, or `decis download` inside it. The container has its own loopback,
# so name the proxy as the container sees it: the host's own `127.0.0.1:<port>` is not
# it.
# These do NOT reach a build: `env_file` applies to containers, and Docker forwards
# neither this file nor your shell's proxy into `RUN`. A build that bakes weights needs
# them as build args, or the download fails with `Network is unreachable`:
#   docker compose build --build-arg HTTP_PROXY=$HTTP_PROXY \
#     --build-arg HTTPS_PROXY=$HTTPS_PROXY --build-arg NO_PROXY=$NO_PROXY
# Keep the loopback addresses in NO_PROXY as well. A probe runs in this environment too, and
# a probe that inherits the proxy asks it for `http://127.0.0.1:8000/healthz` and is judged
# unhealthy if they are missing.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=127.0.0.1,localhost,::1

# --- engine -----------------------------------------------------------------
# Which engine answers a request whose `model` is a "your default" name
# (e.g. the SDK's `jev-latest`), and which one `decis serve` loads at startup.
DECIS_DEFAULT_ENGINE=laya-multilingual

# Accept "jev-latest" (the official SDK's default model name) and similar
# "whatever default you run" names, answering with the loaded engine instead of
# returning 422. This is what makes swapping TYPESAFE_BASE_URL alone sufficient.
# The substitution is reported in the response under decis.requested_model.
# DECIS_ACCEPT_FOREIGN_DEFAULTS=1

# Where model weights live. A directory found here wins over the network, so an
# image with weights baked in never reaches out. Expected layout is
# <DECIS_MODEL_DIR>/<engine-id>/, and a raw snapshot_download (which nests a
# subfolder inside) is recognised too. `decis download` writes <engine-id>/ here;
# with this unset it writes to the Hugging Face cache, which is where `decis serve`
# looks when no directory is configured.
# The published images bake their weights into /models and docker-compose pins this
# variable to that path, so changing it here only affects `decis serve` outside
# compose -- and it must point at a directory that actually holds the weights.
# DECIS_MODEL_DIR=/app/models

# Point ONE engine at a directory of your own -- a fine-tune, or weights on a
# different volume. The suffix is the engine id uppercased with "-" replaced by
# "_", so "laya-multilingual" becomes DECIS_MODEL_PATH_LAYA_MULTILINGUAL. This
# beats DECIS_MODEL_DIR. A dot has no representation in the reverse mapping, so an
# id that contains one (kev-0.8b) has no usable override -- KEV_0_8B comes back as
# the id "kev-0-8b", which is registered as nothing and is dropped without a
# warning. Use DECIS_MODEL_DIR with a kev-0.8b/ subdirectory for that engine.
# DECIS_MODEL_PATH_LAYA_MULTILINGUAL=/srv/finetunes/acme-triage

# --- limits -----------------------------------------------------------------
# Rejected before the body is read, so a huge `state` cannot exhaust memory.
DECIS_MAX_REQUEST_BYTES=2097152
# Must stay under the official SDK's 10 s per-request timeout: past that the SDK
# gives up and RE-SENDS, which multiplies load on a server that is already busy.
DECIS_REQUEST_TIMEOUT_MS=8000

# --- runtime ----------------------------------------------------------------
# Leave unset to let torch choose its own default (one thread per vCPU). That is a
# default, not a recommendation: in the checked-in sweep the fastest thread count
# depends on the request size, so measure before sizing a deployment. See
# docs/configuration.md, "Compute".
# DECIS_TORCH_THREADS=8
DECIS_LOG_LEVEL=info
# Request and response bodies are not logged: they can contain user data.

# How long shutdown waits for an in-flight engine load before exiting without
# closing it. Must be below your orchestrator's terminationGracePeriodSeconds, or
# SIGKILL arrives while we are still waiting.
#DECIS_SHUTDOWN_GRACE_MS=20000

# Force a device: cuda, mps or cpu. Unset picks the best available. Useful for running
# a CPU-only comparison on a GPU host, and for pinning dtype selection -- kev's dtype
# default depends on the device (fp32 on cpu, bf16 on cuda; see docs/feasibility.md §4).
#DECIS_DEVICE=cpu

# Force fp32 / fp16 / bf16 for the served engine. Unset picks per (engine, device) from
# DTYPE_DEFAULTS in src/decis/engines/registry.py. Mainly for re-measuring a dtype on
# your own hardware; a combination Decis knows to be bad logs a warning rather than
# being refused. Engines that decide dtype themselves (Laya) ignore this.
#DECIS_DTYPE=bf16
