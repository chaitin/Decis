{
  "openapi": "3.1.0",
  "info": {
    "title": "Decis",
    "summary": "One API to run all light-weight decision models.",
    "description": "A drop-in implementation of the TypeSafe / jev System One API, backed by open decision models. Point the official `typesafe-sdk` here by setting `TYPESAFE_BASE_URL`.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/systemone": {
      "post": {
        "summary": "Ask questions about one piece of content",
        "description": "Answer every question about `state` with the selected model.\n\nPure: the same request always produces the same answer for a given model,\nbecause the official SDK retries POSTs automatically.\n\n**Not `async` by accident.** Inference is synchronous and CPU-bound, and\n`service.answer` is a plain function. Declaring this route `async` would run\nit *on the event loop*, so a single inference -- hundreds of milliseconds,\nand seconds for a long state -- would stop the server from answering\nanything else, `/healthz` included. A probe arriving during inference would\nhang, and an orchestrator could kill a container that is working correctly.\nStarlette runs a plain `def` route in its worker threadpool instead, which\nleaves the loop free and lets `InProcessScheduler`'s lock -- rather than the\nevent loop -- be the thing that serialises the engine.",
        "operationId": "systemone_v1_systemone_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemOneRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemOneResponse"
                }
              }
            }
          },
          "401": {
            "description": "The supplied API key is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "No API key was supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "summary": "List the models this server can run",
        "operationId": "models_v1_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelMetadataList"
                }
              }
            }
          },
          "401": {
            "description": "The supplied API key is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "No API key was supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
