          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "error_type",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    }
  },
  "description": "Documented for our own OpenAPI output. Not part of the jev contract.",
  "example": {
